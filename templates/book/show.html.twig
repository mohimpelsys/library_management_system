{% extends 'base.html.twig' %}

{% block title %}Book Details{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="row g-5 align-items-center">
            <!-- Left: Book Details -->
            <div class="col-md-7">
                <h1 class="mb-4" style="color: #6d3d2c;">
                    📖 {{ book.title }}
                </h1>

                <p style="font-size: 1.2rem;">
                    <strong>✍️ Author:</strong> {{ book.author }}
                </p>

                <p style="font-size: 1.2rem;">
                    <strong>🔢 ISBN:</strong> {{ book.isbn }}
                </p>

                <p style="font-size: 1.2rem;">
                    <strong>📘 Book ID:</strong> {{ book.id }}
                </p>

                {% if book.description %}
                    <p style="font-size: 1.2rem;">
                        <strong>📝 Description:</strong><br>
                        {{ book.description }}
                    </p>
                {% else %}
                    <p style="font-size: 1.2rem;" class="text-muted">
                        <strong>📝 Description:</strong> No description available.
                    </p>
                {% endif %}

                <div class="mt-4">
                    <a href="{{ path('app_book_index') }}" class="btn btn-secondary">← Back to list</a>
                </div>
            </div>

            <!-- Right: Book Image -->
            <div class="col-md-5 d-flex justify-content-center">
                {% if book.image %}
                    <img
                        src="{{ asset('uploads/' ~ book.image) }}"
                        class="img-fluid rounded shadow"
                        style="max-height: 400px;"
                    >
                {% else %}
                    <div class="text-muted">No cover image</div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}
