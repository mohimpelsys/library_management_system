{% extends 'base.html.twig' %}

{% block title %}Welcome To The Library!{% endblock %}

{% block stylesheets %}{{ parent() }}<style>
    h1 {
        color: #6d4c41;
        text-align: center;
        margin: 40px 0 20px 0;
    }
    .navbar {
        background-color: #6d4c41;
    }
    .navbar .nav-link {
        color: #fff;
    }
    .navbar .nav-link:hover {
        color: #d7ccc8;
    }
    table {
        background-color: #ffffff;
    }
    th, td {
        color: #3e2723;
    }
</style>{% endblock %}

{% block body %}
    <h1>📖 Library Management System</h1>

    <nav class="navbar navbar-expand-lg mb-4 rounded">
        <div class="container-fluid justify-content-end">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_book_index') }}">🏠 Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('user_borrows') }}">📘 Borrowed Books</a>
                </li>
                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_logout') }}">🔒 Logout</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </nav>

    <div class="container py-4">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div class="btn-group">
                <a href="{{ path('app_book_index', {'sort': 'title', 'q': searchTerm}) }}" class="btn btn-outline-secondary btn-sm">
                    Sort by Title
                </a>
                <a href="{{ path('app_book_index', {'sort': 'isbn', 'q': searchTerm}) }}" class="btn btn-outline-secondary btn-sm">
                    Sort by ISBN
                </a>
            </div>

            <form method="get" action="{{ path('app_book_index') }}" class="d-flex align-items-center" role="search">
                <input type="text" name="q" class="form-control form-control-sm me-2" placeholder="Search title, author, or ISBN" value="{{ searchTerm }}">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
            </form>
        </div>

        <table class="table table-striped">
            <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
                <th>ISBN</th>
                <th>Image</th>
                <th>Actions</th>
                <th>Show</th>
            </tr>
            </thead>
            <tbody>
            {% for book in books %}
                <tr>
                    <td>{{ book.title }}</td>
                    <td>{{ book.author }}</td>
                    <td>{{ book.isbn }}</td>
                    <td>
                        {% if book.image %}
                            <img src="{{ asset('uploads/' ~ book.image) }}" alt="{{ book.title }}" width="50">
                        {% else %}
                            <span class="text-muted">No image</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                Actions
                            </button>
                            <ul class="dropdown-menu">
                                {% if app.user and book.id in borrowedBookIds %}
                                    <li><button class="dropdown-item disabled">Already Borrowed</button></li>
                                {% else %}
                                    <li>
                                        <a class="dropdown-item" href="{{ path('app_borrow_book', {'bookId': book.id}) }}">
                                            Borrow
                                        </a>
                                    </li>
                                {% endif %}
                                {% if is_granted('ROLE_ADMIN') %}
                                    <li>
                                        <a class="dropdown-item" href="{{ path('app_book_edit', {'id': book.id}) }}">
                                            Edit
                                        </a>
                                    </li>
                                    <li>
                                        <form method="post" action="{{ path('app_book_delete', {'id': book.id}) }}" onsubmit="return confirm('Are you sure?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ book.id) }}">
                                            <button class="dropdown-item text-danger">Delete</button>
                                        </form>
                                    </li>
                                {% endif %}
                            </ul>
                        </div>
                    </td>
                    <td>
                        <a href="{{ path('app_book_show', {'id': book.id}) }}" class="btn btn-dark btn-sm">Show</a>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="7">No records found</td></tr>
            {% endfor %}
            </tbody>
        </table>

        {% if is_granted('ROLE_ADMIN') %}
            <a href="{{ path('app_book_new') }}" class="btn btn-success mt-3">➕ Create New</a>
        {% endif %}
    </div>
{% endblock %}
