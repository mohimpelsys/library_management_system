{% extends 'base.html.twig' %}

{% block title %}Welcome To The Library!{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1 class="text-center mb-4 fw-bold" style="color: #4e342e;">📖 Library Management System</h1>

        <div class="d-flex justify-content-end align-items-center mb-4 flex-wrap gap-2">
            <form method="get" action="{{ path('app_book_index') }}" class="d-flex align-items-center" role="search">
                <input type="text" name="q" class="form-control form-control-sm me-2" placeholder="Search title, author, or ISBN" value="{{ searchTerm }}">
                <button type="submit" class="btn btn-sm btn-outline-secondary">Search</button>
            </form>
        </div>

        <table class="table table-striped table-bordered align-middle text-center">
            <thead class="table-light">
            <tr>
                <th>
                    Title
                    <a href="{{ path('app_book_index', {'sort': 'title', 'q': searchTerm}) }}"
                       class="btn btn-sm btn-outline-secondary ms-2">
                        🔽
                    </a>
                </th>
                <th>Author</th>
                <th>
                    ISBN
                    <a href="{{ path('app_book_index', {'sort': 'isbn', 'q': searchTerm}) }}"
                       class="btn btn-sm btn-outline-secondary ms-2">
                        🔽
                    </a>
                </th>
                <th>Image</th>
                <th>Actions</th>
            </tr>
            </thead>
            <tbody>
            {% for book in books %}
                <tr>
                    <td>{{ book.title }}</td>
                    <td>{{ book.author }}</td>
                    <td>{{ book.isbn }}</td>
                    <td>
                        {% if book.image %}
                            <img src="{{ asset('uploads/' ~ book.image) }}" alt="{{ book.title }}" width="50">
                        {% else %}
                            <span class="text-muted">No image</span>
                        {% endif %}
                    </td>
                    <td>
                        <div class="dropdown">
                            <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                Actions
                            </button>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" href="{{ path('app_book_show', {'id': book.id}) }}">
                                        📖 Show
                                    </a>
                                </li>

                                {% if app.user and book.id in borrowedBookIds %}
                                    <li>
                                        <button class="dropdown-item disabled">✅ Already Borrowed</button>
                                    </li>
                                {% else %}
                                    <li>
                                        <a class="dropdown-item" href="{{ path('app_borrow_book', {'bookId': book.id}) }}">
                                            📚 Borrow
                                        </a>
                                    </li>
                                {% endif %}

                                {% if isAdmin %}
                                    <li>
                                        <a class="dropdown-item text" href="{{ path('app_book_edit', {'id': book.id}) }}">
                                            ✏️ Edit
                                        </a>
                                    </li>
                                    {% if book.id in borrowedBookIds %}
                                        <li>
                                            <button class="dropdown-item text-muted" style="opacity: 0.6; pointer-events: none;" disabled>
                                                🚫 Currently Borrowed
                                            </button>
                                        </li>
                                    {% else %}
                                        <li>
                                            <form method="post" action="{{ path('app_book_delete', {'id': book.id}) }}" onsubmit="return confirm('Are you sure?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ book.id) }}">
                                                <button class="dropdown-item text-danger" type="submit">🗑️ Delete</button>
                                            </form>
                                        </li>
                                    {% endif %}
                                {% endif %}
                            </ul>
                        </div>
                    </td>
                </tr>
            {% else %}
                <tr>
                    <td colspan="5" class="text-muted">No records found</td>
                </tr>
            {% endfor %}
            </tbody>
        </table>

        {% if is_granted('ROLE_ADMIN') %}
            <div class="text-end mt-3">
                <a href="{{ path('app_book_new') }}" class="btn btn-success">➕ Create New</a>
            </div>
        {% endif %}
    </div>
{% endblock %}
