{% extends 'base.html.twig' %}

{% block title %}Book Search{% endblock %}

{% block body %}
    <h1>Book Search</h1>

    <nav class="navbar navbar-expand-lg navbar-light bg-light mb-3">
        <div class="container-fluid justify-content-end">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('app_book_index') }}">Home</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="{{ path('user_borrows') }}">Borrowed Books</a>
                </li>
                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_logout') }}">Logout</a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </nav>

    <form method="get" action="{{ path('app_book_index') }}" style="margin-bottom: 1rem;">
        <input type="text" name="q" placeholder="Search title, author, or ISBN" value="{{ searchTerm }}">
        <button type="submit">Search</button>
    </form>

    <table class="table">
        <thead>
        <tr>
            <th>Id</th>
            <th>Title</th>
            <th>Author</th>
            <th>ISBN</th>
            <th>Image</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for book in books %}
            <tr>
                <td>{{ book.id }}</td>
                <td>{{ book.title }}</td>
                <td>{{ book.author }}</td>
                <td>{{ book.isbn }}</td>
                <td>
                    {% if book.image %}
                        <img src="{{ asset('uploads/' ~ book.image) }}" alt="{{ book.title }}" width="50">
                    {% else %}
                        No image
                    {% endif %}
                </td>
                <td>
                    <div class="dropdown">
                        <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                aria-expanded="false">
                            Actions
                        </button>
                        <ul class="dropdown-menu">
                            {% if app.user and book.id in borrowedBookIds %}
                                <li><button class="dropdown-item disabled">Already Borrowed</button></li>
                            {% else %}
                                <li><a class="dropdown-item" href="{{ path('app_borrow_book', {'bookId': book.id}) }}">
                                        Borrow
                                    </a></li>
                            {% endif %}

                            {% if is_granted('ROLE_ADMIN') %}
                                <li><a class="dropdown-item" href="{{ path('app_book_edit', {'id': book.id}) }}">
                                        Edit
                                    </a></li>
                                <li>
                                    <form method="post" action="{{ path('app_book_delete', {'id': book.id}) }}"
                                          onsubmit="return confirm('Are you sure you want to delete this book?');">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ book.id) }}">
                                        <button class="dropdown-item text-danger">Delete</button>
                                    </form>
                                </li>
                            {% endif %}
                        </ul>
                        <td>
                        <a href="{{ path('app_book_show', {'id': book.id}) }}" class="btn btn-dark">Show</a>
                        </td>
                    </div>
                </td>

            </tr>
        {% else %}
            <tr>
                <td colspan="6">No records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    {% if is_granted('ROLE_ADMIN') %}
        <a href="{{ path('app_book_new') }}" class="btn btn-success mt-3">Create new</a>
    {% endif %}
{% endblock %}
