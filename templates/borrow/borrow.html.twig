{% extends 'base.html.twig' %}

{% block title %}Borrow Book{% endblock %}

{% block body %}
    <h1>Borrow "{{ book.title }}"</h1>

    {{ form_start(form) }}
    {{ form_row(form.borrowedAt) }}
    {{ form_row(form.dueDate) }}
    <button class="btn btn-primary">Borrow</button>
    {{ form_end(form) }}

    <a href="{{ path('app_book_index') }}">Back to book list</a>
{% endblock %}
