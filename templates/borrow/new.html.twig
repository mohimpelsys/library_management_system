{% extends 'base.html.twig' %}

{% block title %}Borrow Book{% endblock %}

{% block stylesheets %}
{% endblock %}

{% block body %}
    <div class="container mt-5">
        <h1>📘 Borrow Book</h1>

        <div class="card p-3">
            <div class="card-body">
                {{ form_start(form) }}

                {# Global errors (if any) #}
                {% for error in form.vars.errors %}
                    <div class="alert alert-danger">{{ error.message }}</div>
                {% endfor %}

                {# Show auto-set borrowedAt (read-only) #}
                <div class="mb-3">
                    <label class="form-label">Borrowed On</label>
                    <div class="readonly-field">
                        {{ borrowDto.borrowedAt|date('d-m-Y') }}
                    </div>
                </div>

                <div class="mb-3">
                    {{ form_label(form.dueDate) }}
                    {{ form_widget(form.dueDate, {'attr': {'class': 'form-control'}}) }}

                    {% if form.dueDate.vars.errors|length > 0 %}
                        {% for error in form.dueDate.vars.errors %}
                            <div class="text-danger">
                                {{ error.message }}
                            </div>
                        {% endfor %}
                    {% endif %}
                </div>


                <button type="submit" class="btn btn-primary">📚 Borrow</button>
                <a href="{{ path('app_book_index') }}" class="btn btn-secondary ms-2" data-turbo="false">🔙 Back to list</a>

                {{ form_end(form) }}
            </div>
        </div>
    </div>
{% endblock %}
