{% extends 'base.html.twig' %}

{% block title %}My Borrowed Books{% endblock %}

{% block stylesheets %}
    <style>
        body {
            background-color: #2b2b2b;
            color: brown;
            font-family: 'Segoe UI', sans-serif;
        }

        h1, h2 {
            color: #d9b382;
            border-bottom: 2px solid #a1887f;
            padding-bottom: 10px;
            margin-bottom: 30px;
        }

        table {
            background-color: #3a3a3a;
            border-radius: 10px;
            overflow: hidden;
        }

        th {
            background-color: #5d4037;
            color: #fff;
        }

        td {
            background-color: #4e342e;
        }

        .navbar {
            background-color: #6d4c41 !important;
        }

        .navbar .nav-link {
            color: #f5f5f5 !important;
        }

        .navbar .nav-link:hover {
            color: #d7ccc8 !important;
        }

        .btn-danger {
            background-color: #c62828;
            border-color: #b71c1c;
        }

        .btn-danger:hover {
            background-color: #e53935;
        }

        .alert-success {
            background-color: #2e7d32;
            color: #ffffff;
        }

        .table-striped tbody tr:nth-of-type(odd) {
            background-color: #5d4037;
        }

        .table-striped tbody tr:nth-of-type(even) {
            background-color: #4e342e;
        }
    </style>
{% endblock %}

{% block body %}
    <div class="container py-4">
        <h1>📚 My Borrowed Books</h1>

        <nav class="navbar navbar-expand-lg mb-4 rounded">
            <div class="container-fluid justify-content-end">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" href="{{ path('app_book_index') }}">🏠 Home</a>
                    </li>
                    {% if app.user %}
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_logout') }}">🔒 Logout</a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        </nav>

        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert" style="background-color: #d4edda; color: #155724; border: none;">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        {% endfor %}

        {# Section 1: Current borrowed books #}
        <h2>📌 Currently Borrowed</h2>

        {% if currentBorrows is not empty %}
            <table class="table table-striped text-light table-hover mt-3">
                <thead>
                <tr>
                    <th>📖 Title</th>
                    <th>🗃️ Borrowed On</th>
                    <th>⏳ Due Date</th>
                    <th>💰 Fine</th>
                    <th>🚀 Return</th>
                </tr>
                </thead>
                <tbody>
                {% for borrow in currentBorrows %}
                    <tr>
                        <td>{{ borrow.title }}</td>
                        <td>{{ borrow.borrowedAt|date('Y-m-d') }}</td>
                        <td>{{ borrow.dueDate ? borrow.dueDate|date('Y-m-d') : 'N/A' }}</td>
                        <td>
                            {% if borrow.fine > 0 %}
                                <span style="color: #ff7043;">₹{{ borrow.fine }}</span>
                            {% else %}
                                ₹0
                            {% endif %}
                        </td>
                        <td>
                            <form method="post" action="{{ path('return_book', {'id': borrow.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('return' ~ borrow.id) }}">
                                <button type="submit" class="btn btn-danger btn-sm">Return</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>You haven't borrowed any books yet.</p>
        {% endif %}

        <hr class="my-5">

        {# Section 2: History of returned books #}
        <h2>📂 Borrow History</h2>

        {% if returnedBorrows is not empty %}
            <table class="table table-striped text-light table-hover mt-3">
                <thead>
                <tr>
                    <th>📖 Title</th>
                    <th>🗃️ Borrowed On</th>
                    <th>⏳ Due Date</th>
                    <th>📤 Returned At</th>
                    <th>💰 Fine</th>
                </tr>
                </thead>
                <tbody>
                {% for borrow in returnedBorrows %}
                    <tr>
                        <td>{{ borrow.title }}</td>
                        <td>{{ borrow.borrowedAt|date('Y-m-d') }}</td>
                        <td>{{ borrow.dueDate ? borrow.dueDate|date('Y-m-d') : 'N/A' }}</td>
                        <td>{{ borrow.returnedAt ? borrow.returnedAt|date('Y-m-d') : 'Not Returned' }}</td>
                        <td>
                            {% if borrow.fine > 0 %}
                                <span style="color: #ff7043;">₹{{ borrow.fine }}</span>
                            {% else %}
                                ₹0
                            {% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        {% else %}
            <p>No previous borrowed books found.</p>
        {% endif %}
    </div>
{% endblock %}
