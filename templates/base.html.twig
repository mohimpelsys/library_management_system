<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Prevent browser from caching protected pages -->
{#    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />#}
{#    <meta http-equiv="Pragma" content="no-cache" />#}
{#    <meta http-equiv="Expires" content="0" />#}

    <title>{% block title %}Welcome!{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        {% if app.user %}
        body {
            padding-top: 70px;
        }
        {% endif %}

        .nav-link {
            font-weight: bold !important;
            color: #000 !important;
        }

        .navbar-brand {
            font-weight: bold;
            color: #000 !important;
        }
    </style>


    {% block stylesheets %}
    {% endblock %}
    <style>
        body {
            padding-top: 70px; /* Adjust to match your navbar height */
        }

        .navbar {
            position: fixed;
            top: 0;
            width: 100%;
            z-index: 1000;
        }
    </style>
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body class="bg-white">

{# ✅ Flash messages shown always #}
{% for label, messages in app.flashes %}
    {% for message in messages %}
        <div class="alert alert-{{ label }} text-center mt-3" style="max-width: 800px; margin: auto;">
            {{ message }}
        </div>
    {% endfor %}
{% endfor %}

<nav class="navbar navbar-expand-lg bg-light shadow-sm fixed-top">
    <div class="container-fluid">
        <a class="navbar-brand fw-bold text-dark" href="{{ path('app_book_index') }}">
            {% if app.request.attributes.get('_route') == 'user_borrows' %}
                📘 My Borrowed Books
            {% else %}
                📚 Library
            {% endif %}
        </a>

        <div class="collapse navbar-collapse justify-content-end">
            <ul class="navbar-nav">
                {% if app.user %}
                    <li class="nav-item">
                        <a class="nav-link fw-bold text-dark {% if app.request.attributes.get('_route') == 'app_book_index' %}active{% endif %}" href="{{ path('app_book_index') }}" data-turbo="false">
                            🏠 Home
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold text-dark {% if app.request.attributes.get('_route') == 'user_borrows' %}active{% endif %}" href="{{ path('user_borrows') }}" data-turbo="false">
                            📘 Borrowed Books
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold text-dark" href="{{ path('app_logout') }}" data-turbo="false">
                            🔒 Logout
                        </a>
                    </li>
                {% else %}
                    <li class="nav-item">
                        <a class="nav-link fw-bold text-dark {% if app.request.attributes.get('_route') == 'app_login' %}active{% endif %}" href="{{ path('app_login') }}">
                            🔓 Login
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link fw-bold text-dark {% if app.request.attributes.get('_route') == 'app_register' %}active{% endif %}" href="{{ path('app_register') }}">
                            📝 Register
                        </a>
                    </li>
                {% endif %}
            </ul>
        </div>
    </div>
</nav>




{% block body %}{% endblock %}

{% if app.user %}
    <script>
        const navEntries = performance.getEntriesByType('navigation');
        if (navEntries.length > 0 && navEntries[0].type === 'back_forward') {
            // Force reload from server when back/forward button is used
            location.reload(true);
        }
    </script>
{% endif %}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
